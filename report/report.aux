\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Results from SBI application on gravitational microlensing by \cite  {microlensing-sbi}. Left: Corner plot of posterior distributions obtained with SBI (a) and simulated lightcurves (b). The posterior has five modes which are modeled accurately with the true value (orange) close by one of these. Right: Quantile-occurrence plots for parameters used in the model. $\text  {log}_{10}(t)$, $u_0$ and $f_\text  {S}$ are biased, while $t_0$ and $\alpha $ are underconfident. The figures are taken from \cite  {microlensing-sbi}.}}{7}{figure.caption.5}\protected@file@percent }
\newlabel{fig:microlensing}{{5}{7}{Results from SBI application on gravitational microlensing by \cite {microlensing-sbi}. Left: Corner plot of posterior distributions obtained with SBI (a) and simulated lightcurves (b). The posterior has five modes which are modeled accurately with the true value (orange) close by one of these. Right: Quantile-occurrence plots for parameters used in the model. $\text {log}_{10}(t)$, $u_0$ and $f_\text {S}$ are biased, while $t_0$ and $\alpha $ are underconfident. The figures are taken from \cite {microlensing-sbi}}{figure.caption.5}{}}
\newlabel{fig:microlensing@cref}{{[figure][5][]5}{[1][6][]7}}
